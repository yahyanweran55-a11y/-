rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidSavedAiItem(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.toolId is string && data.toolId.size() > 0 && data.toolId.size() <= 64 &&
             data.toolTitle is string && data.toolTitle.size() > 0 && data.toolTitle.size() <= 128 &&
             data.inputPrompt is string && data.inputPrompt.size() <= 50000 &&
             data.outputContent is string && data.outputContent.size() <= 200000 &&
             (!('isFavorite' in data) || data.isFavorite is bool) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Subcollection for saved items
      match /saved_items/{itemId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(itemId);
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['userId', 'toolId', 'toolTitle', 'inputPrompt', 'outputContent', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'toolId', 'toolTitle', 'inputPrompt', 'outputContent', 'isFavorite', 'createdAt', 'updatedAt']) &&
                         isValidSavedAiItem(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidSavedAiItem(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['toolTitle', 'inputPrompt', 'outputContent', 'isFavorite', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(itemId);
      }
    }
  }
}
